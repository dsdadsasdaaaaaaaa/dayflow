{
  "expo": {
    "name": "DayFlow",
    "slug": "dayflow",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dayflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.levisilverberg.dayflow",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.levisilverberg.dayflow"
        ]
      },
      "infoPlist": {
        "NSCalendarsUsageDescription": "DayFlow can show your calendar events alongside your tasks in the timeline.",
        "NSCalendarsFullAccessUsageDescription": "DayFlow can show your calendar events alongside your tasks in the timeline.",
        "NSRemindersUsageDescription": "DayFlow can import your reminders as tasks.",
        "NSFaceIDUsageDescription": "DayFlow uses Face ID to unlock the app and keep your schedule private.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "DayFlow can show your calendar events alongside your tasks in the timeline."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-background-task"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.levisilverberg.dayflow.widget",
                  "targetName": "DayFlowWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.levisilverberg.dayflow"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f9ea80fd-eb21-4e5b-bbd1-6f70bddf9f27"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9ea80fd-eb21-4e5b-bbd1-6f70bddf9f27"
    }
  }
}
